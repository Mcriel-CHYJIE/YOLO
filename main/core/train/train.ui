      </property>

      <!-- Chart row -->
      <item><layout class="QHBoxLayout" name="chartRow">
       <item><widget class="QGroupBox" name="lcContainer">
        <property name="title"><string>● Loss</string></property>
        <layout class="QVBoxLayout" name="lcLo">
         <property name="leftMargin"><number>8</number></property>
