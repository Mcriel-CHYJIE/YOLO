# =============================================================================
# Project Configuration — defines project identity & UI defaults
# All tabs (Training, Validate, Distill, Predict, Export, Dataset) read from here.
# Make a copy for a new project (e.g. fire detection) and just swap the file.
# =============================================================================

# ── Project Identity ──
project:
  name: YOLO Training Studio         # Window title
  task: detect                         # YOLO task (detect / segment / classify)
  classes: ['standing', 'sitting', 'squatting', 'fallen']
  names:                               # YOLO class definitions with descriptions
    0: standing                        # 站立
    1: sitting                         # 坐姿
    2: squatting                       # 蹲姿
    3: fallen                          # 摔倒/躺卧
  data_yaml: datasets/data.yaml         # Relative to project root
  tip: "🦶 Balanced → LS+SIoU+Rot15"    # Shown in Algorithm group box

# ── Training Defaults ──
training:
  model: yolo11n.pt                    # Nano model - lightweight, suitable for RTX 5070 Ti
  model_options:                       # Available models in dropdown
    - yolo11n.pt
    - yolo11s.pt
    - yolo11m.pt
    - yolo11l.pt
    - yolo11x.pt
  epochs: 800                          # Extended training for maximum accuracy (time not a concern)
  batch: 32                            # Optimized batch size for yolo11n on 16GB VRAM
  imgsz: 640                           # Fixed image size as requested
  imgsz_options: [416, 512, 640, 800]
  optimizer: AdamW                     # Best optimizer for long training with stable convergence
  optimizer_options: [AdamW, Adam, SGD]
  device: auto                         # auto = detect GPU; fallback to CPU
  scheduler: cosine                    # Cosine annealing with warmup for optimal learning
  scheduler_options: [Cosine, Linear]
  patience: 100                        # Extended patience for thorough best model search
  lr0: 0.002                           # Slightly higher LR for better exploration
  lrf: 0.01                            # Final LR = 0.002 * 0.01 = 0.00002
  warmup_epochs: 15                    # Longer warmup for stable training start
  workers: 8                           # Increased workers for faster data loading
  momentum: 0.937                      # Optimizer momentum
  weight_decay: 0.0005                 # L2 regularization
  # Algorithm - Enhanced augmentation for maximum accuracy
  iou: 0.7                             # Standard IoU threshold
  close_mosaic: 30                     # Close mosaic last 30 epochs for fine-tuning
  copy_paste: 0.3                      # Aggressive copy-paste augmentation
  degrees: 15.0                        # Increased rotation augmentation
  multi_scale: false                   # DISABLED to maintain consistent 640 input size
  hsv_h: 0.015                         # Hue augmentation
  hsv_s: 0.7                           # Saturation augmentation
  hsv_v: 0.4                           # Brightness augmentation
  translate: 0.15                      # Increased translation
  scale: 0.6                           # Wider scale range 0.4-1.6x
  flip_lr: 0.5                         # Horizontal flip

# ── Validation Defaults ──
validation:
  imgsz: 640
  batch: 32
  conf: 0.25
  iou: 0.45

# ── Distillation Defaults ──
distill:
  teacher: ''                          # Empty = auto-find latest runs/*/weights/best5.20.pt
  student: models/yolo11n.pt                   # Student model (smaller than teacher)
  epochs: 150                          # Extended epochs for better knowledge transfer
  batch: 24                            # Optimized batch size for distillation (teacher frozen, less memory)
  lr0: 0.002                           # Higher LR for faster convergence in distillation
  alpha: 0.5                           # Balanced weight: 50% detection loss + 50% distillation loss
  patience: 40                         # Extended patience for thorough search
  imgsz: 640                           # Same as training for consistency
  warmup_epochs: 5                     # Shorter warmup for distillation
  weight_decay: 0.0005                 # L2 regularization
  momentum: 0.937                      # Optimizer momentum

# ── Prediction / Inference Defaults ──
predict:
  conf: 0.25
  iou: 0.45
  imgsz: 640

# ── Export Defaults ──
export:
  format: onnx
  format_options: [onnx, torchscript, ncnn, openvino, tensorrt, tflite, edgetpu, coreml]
  imgsz: 640
  imgsz_options: [320, 416, 640, 800, 1280]
  half: false
  int8: false
  nms: false
